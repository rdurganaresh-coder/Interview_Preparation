<script data-nocturne="true"> $(function () {
    $("._FilterByTagsFrame_tagBox img").click(function () {
        $(this).closest("._FilterByTagsFrame_tagBox").remove();
    });

    $("._FilterByTagsFrame_addTagLink").click(function () {
        $(this).hide();
        $("._FilterByTagsFrame_addTagLabel").show();
    });

    $("._FilterByTagsFrame_addTag select").change(function () {
        var title = $('option:selected', this).attr('title');
        var name = $('option:selected', this).attr('value');
        if (title && $("._FilterByTagsFrame_tagBoxes [title='" + title + "']").length === 0) {
            var $proto = $("._FilterByTagsFrame_tagBoxPrototype").clone();
            $proto.removeClass("_FilterByTagsFrame_tagBoxPrototype");
            $proto.addClass("_FilterByTagsFrame_tagBox");
            $proto.find("._FilterByTagsFrame_tagBoxItem").attr("title", title).attr("data-name", name);
            $proto.find("._FilterByTagsFrame_tagBoxCaption").text($('option:selected', this).text());
            $proto.find("img").click(function () {
                $(this).closest("._FilterByTagsFrame_tagBox").remove();
            });
            $("._FilterByTagsFrame_tagBoxes").append($proto);
        }
    });

    $("._FilterByTagsFrame_main form").submit(function() {
        var tags="";
        $("._FilterByTagsFrame_tagBox ._FilterByTagsFrame_tagBoxItem").each(function () {
            if (tags.length > 0) {
                tags += ",";
            }
            tags += $(this).attr("data-name");
        });
        var minDifficulty = $("._FilterByTagsFrame_difficulty input[name='minDifficulty']").val();
        var maxDifficulty = $("._FilterByTagsFrame_difficulty input[name='maxDifficulty']").val();
        if (minDifficulty || maxDifficulty) {
            if (tags.length > 0) {
                tags += ",";
            }
            tags += minDifficulty + "-" + maxDifficulty;
        }
        Codeforces.redirect("?tags=" + tags);
        return false;
    });
}); </script>

