    <script>
        $(function () {
            $(".info-bar-button[data-contestParticipantId]").click(function () {
                const $this = $(this);
                const contestParticipantId = $(this).attr("data-contestParticipantId");
                const contestId = $(this).attr("data-contestId");
                const message = "Are you sure you want to change registration type to RATED?";
                if (confirm(message)) {
                    $.post("/data/contestRegistration/000000".replaceAll("000000", contestId),
                        {action: "setUnrated", participantId: contestParticipantId, unrated: false}, function(json) {
                            if (json["success"] === "true") {
                                Codeforces.showMessage("Registration type has been changed.");
                                $this.closest("div[data-infoBarId='0']").fadeOut();
                            } else {
                                alert("Can't change registration type. The contest has already started or contest policy doesn't allow to change registration type.");
                            }
                        }, "json");
                }
                return false;
            });
        })
    </script>
        
