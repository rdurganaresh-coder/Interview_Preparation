{
  "name": "front-end-mastery",
  "version": "1.0.0",
  "private": true,
  "description": "Modular Front-End Mastery workspace",
  "workspaces": [
    "html-css-js",
    "typescript-core",
    "react-workspace/apps/*",
    "react-workspace/packages/*"
  ],
  "scripts": {
    "react:dev": "npm run dev -w @mastery/react-web",
    "react:build": "npm run build -w @mastery/react-web",
    "ts:typecheck": "npm run typecheck -w @mastery/typescript-core",
    "angular:install": "npm install --prefix angular-workspace",
    "angular:start": "npm start --prefix angular-workspace"
  }
}
