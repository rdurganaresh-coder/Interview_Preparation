{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "angular-basics": {
      "projectType": "application",
      "root": "projects/angular-basics",
      "sourceRoot": "projects/angular-basics/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/angular-basics",
            "index": "projects/angular-basics/src/index.html",
            "browser": "projects/angular-basics/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/angular-basics/tsconfig.app.json",
            "assets": [],
            "styles": [],
            "scripts": []
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "angular-basics:build",
            "port": 4201
          }
        }
      }
    },
    "angular-dashboard": {
      "projectType": "application",
      "root": "projects/angular-dashboard",
      "sourceRoot": "projects/angular-dashboard/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/angular-dashboard",
            "index": "projects/angular-dashboard/src/index.html",
            "browser": "projects/angular-dashboard/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/angular-dashboard/tsconfig.app.json",
            "assets": [],
            "styles": [],
            "scripts": []
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "angular-dashboard:build",
            "port": 4202
          }
        }
      }
    }
  }
}
